{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write ./app",
    "format:check": "biome format ./app",
    "lint": "biome lint ./app",
    "lint:fix": "biome lint --write ./app",
    "check": "biome check ./app",
    "check:fix": "biome check --write ./app"
  },
  "dependencies": {
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.26.1",
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "pnpm exec biome format --write",
      "pnpm exec biome lint --write",
      "pnpm exec biome check"
    ]
  }
}